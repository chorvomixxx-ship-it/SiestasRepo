<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>
<addon id="plugin.video.Siestas" name="[COLOR darkorange][B]SIESTAS[/B][/COLOR]" version="5.0.0" provider-name="Siestas">
    <requires>
        <import addon="xbmc.python" version="3.0.0" />
    </requires>
    <extension point="xbmc.python.pluginsource" library="default.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="es_es">Tu videoclub personal de películas y series en castellano</summary>
        <description lang="es_es">SIESTAS: Tu videoclub personal con miles de películas organizadas por géneros, sagas, estrenos y rankings. Búsqueda avanzada por título, actor, director y año. Sistema de favoritos integrado. Integración con Elementum y metadatos TMDB. Compatible con Kodi 21 Omega.</description>
        <platform>all</platform>
        <assets>
            <icon>portada.jpg</icon>
            <fanart>fanart.jpg</fanart>
        </assets>
    </extension>
</addon>
<addon id="repository.siestas" name="Siestas Repository" version="1.0.0" provider-name="Siestas">
    <extension point="xbmc.addon.repository" name="Siestas Repository">
        <info compressed="false">https://raw.githubusercontent.com/chorvomixxx-ship-it/SiestasRepo/main/addons.xml</info>
        <checksum>https://raw.githubusercontent.com/chorvomixxx-ship-it/SiestasRepo/main/addons.xml.md5</checksum>
        <datadir zip="true">https://raw.githubusercontent.com/chorvomixxx-ship-it/SiestasRepo/main</datadir>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="es_es">Repositorio oficial de SIESTAS</summary>
        <description lang="es_es">Instala y actualiza automáticamente el addon SIESTAS desde GitHub.</description>
        <platform>all</platform>
    </extension>
</addon>
</addons>
