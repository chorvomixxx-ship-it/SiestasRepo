<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>
<addon id="plugin.video.Siestas" name="[COLOR darkorange][B]SIESTAS[/B][/COLOR]" version="5.2.1" provider-name="Siestas">
    <requires>
        <import addon="xbmc.python" version="3.0.0" />
    </requires>
    <extension point="xbmc.python.pluginsource" library="default.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.service" library="service.py" start="startup" />
    <extension point="xbmc.addon.metadata">
        <summary lang="es_es">Tu videoclub personal de películas, series y documentales en castellano</summary>
        <description lang="es_es">SIESTAS: Tu videoclub personal con miles de películas, series y documentales organizados por géneros, estrenos y rankings. Búsqueda avanzada por título, actor, director y año. Sistema de favoritos y seguimiento de contenido visto integrado. Integración con Elementum y metadatos TMDB. Compatible con Kodi 21 Omega.</description>
        <platform>all</platform>
        <assets>
            <icon>portada.jpg</icon>
            <fanart>fanart.jpg</fanart>
        </assets>
    </extension>
</addon>
<addon id="repository.siestas" name="Siestas Repository" version="1.0.3" provider-name="Siestas">
    <extension point="xbmc.addon.repository" name="Siestas Repository">
        <dir>
            <info compressed="false">https://raw.githubusercontent.com/chorvomixxx-ship-it/SiestasRepo/main/addons.xml</info>
            <checksum>https://raw.githubusercontent.com/chorvomixxx-ship-it/SiestasRepo/main/addons.xml.md5</checksum>
            <datadir zip="true">https://raw.githubusercontent.com/chorvomixxx-ship-it/SiestasRepo/main/</datadir>
        </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="es_es">Repositorio oficial de SIESTAS</summary>
        <description lang="es_es">Instala y actualiza automaticamente el addon SIESTAS desde GitHub.</description>
        <platform>all</platform>
    </extension>
</addon>
</addons>
